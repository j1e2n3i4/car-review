<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        /* Custom CSS */
        .category-list {
            margin-top: 2rem;
        }
        .category-item {
            margin-bottom: 1rem;
            padding: 1rem;
            border: 1px solid #ddd;
            border-radius: 0.25rem;
        }
        .category-actions {
            margin-top: 0.5rem;
        }
        .btn {
            margin-right: 0.5rem;
        }
    </style>
</head>
<body>

<header>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <a class="navbar-brand" href="#">Blog Manager</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" href="/blogs">Manage Blogs</a></li>
                <li class="nav-item"><a class="nav-link" href="/categories">Manage Categories</a></li>
                <li class="nav-item"><a class="nav-link" href="/blogs/new">Create New Blog</a></li>
                <li class="nav-item"><a class="nav-link" href="/categories/new">Create New Category</a></li>
                <li class="nav-item"><a class="nav-link" href="/vehicles">List Vehicles</a></li> <!-- Added this line -->
            </ul>
        </div>
        
    </nav>
</header>

<div class="container mt-5">
    <h1>Categories</h1>
    <a href="/categories/new" class="btn btn-primary">Create New Category</a>
    <div class="category-list">
        <ul class="list-group">
            <% categories.forEach(category => { %>
                <li class="list-group-item category-item">
                    <%= category.name %>
                    <% if (category.parent) { %>
                        <small>(Parent: <%= category.parent.name %>)</small>
                    <% } %>
                    <div class="category-actions">
                        <a href="/categories/<%= category._id %>/blogs" class="btn btn-info btn-sm">View Blogs</a>
                        <a href="/categories/<%= category._id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                        <form action="/categories/<%= category._id %>?_method=DELETE" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </li>
            <% }) %>
        </ul>
    </div>
</div>  

<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
