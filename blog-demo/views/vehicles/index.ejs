<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vehicles</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        /* Custom CSS */
        .filter-section {
            margin-top: 2rem;
        }
        .blog-list {
            margin-top: 2rem;
        }
    </style>
</head>
<body>

<header>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <a class="navbar-brand" href="#">Blog Manager</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" href="/blogs">Manage Blogs</a></li>
                <li class="nav-item"><a class="nav-link" href="/categories">Manage Categories</a></li>
                <li class="nav-item"><a class="nav-link" href="/vehicles">Vehicles</a></li>
            </ul>
        </div>
    </nav>
</header>

<div class="container mt-5">
    <h1>Vehicles</h1>
    <div class="filter-section">
        <h3>Filter</h3>
        <form id="filter-form">
            <div class="form-group">
                <label for="category-filter">Categories:</label>
                <div id="category-filter">
                    <% categories.forEach(category => { %>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="<%= category._id %>" id="category-<%= category._id %>">
                            <label class="form-check-label" for="category-<%= category._id %>">
                                <%= category.name %>
                            </label>
                        </div>
                    <% }) %>
                </div>
            </div>
            <div class="form-group">
                <label for="price-min">Min Price:</label>
                <input type="number" class="form-control" id="price-min" name="price-min" placeholder="0">
            </div>
            <div class="form-group">
                <label for="price-max">Max Price:</label>
                <input type="number" class="form-control" id="price-max" name="price-max" placeholder="0">
            </div>
            <button type="submit" class="btn btn-primary">Apply Filters</button>
        </form>
    </div>
    <div class="blog-list mt-4" id="blog-list">
        <!-- Blog items will be injected here by JavaScript -->
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script>
    $(document).ready(function() {
        function loadBlogs() {
            const selectedCategories = [];
            $('#category-filter input:checked').each(function() {
                selectedCategories.push($(this).val());
            });

            const minPrice = $('#price-min').val();
            const maxPrice = $('#price-max').val();

            $.ajax({
                url: '/vehicles/filter',
                method: 'GET',
                data: {
                    categories: selectedCategories,
                    minPrice: minPrice,
                    maxPrice: maxPrice
                },
                success: function(data) {
                    $('#blog-list').html('');
                    data.blogs.forEach(function(blog) {
                        const blogItem = `
                            <div class="card mb-3">
                                <div class="card-body">
                                    <h5 class="card-title">${blog.title}</h5>
                                    <p class="card-text">${blog.description}</p>
                                    <p class="card-text">Price: $${blog.price}</p>
                                    <a href="/blogs/${blog._id}" class="btn btn-primary">View Blog</a>
                                </div>
                            </div>
                        `;
                        $('#blog-list').append(blogItem);
                    });
                }
            });
        }

        $('#filter-form').on('submit', function(e) {
            e.preventDefault();
            loadBlogs();
        });

        loadBlogs(); // Initial load
    });
</script>
</body>
</html>
