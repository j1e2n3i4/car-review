<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= vehicle.title %></title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="container">
        <h1><%= vehicle.title %></h1>
        <% if (vehicle.featuredImage) { %>
            <img src="/uploads/<%= vehicle.featuredImage %>" alt="<%= vehicle.title %>" class="img-fluid">
        <% } %>
        <p><strong>Price:</strong> ₹<%= vehicle.price %></p>
        <p><strong>Categories:</strong> <%= vehicle.categories.map(cat => cat.name).join(', ') %></p>
        <p><strong>Fuel Type:</strong> <%= vehicle.fuelType %></p>
        <p><strong>Transmission:</strong> <%= vehicle.transmission %></p>
        <p><strong>Engine Size:</strong> <%= vehicle.engineSize %></p>
        <p><strong>Mileage:</strong> <%= vehicle.mileage %></p>
        <p><strong>Seating Capacity:</strong> <%= vehicle.seatingCapacity %></p>
        <p><strong>Size:</strong> <%= vehicle.size %></p>
        <p><strong>Fuel Tank:</strong> <%= vehicle.fuelTank %></p>
        <p><%= vehicle.description %></p>
        <a href="/vehicles" class="btn btn-secondary">Back to Vehicles</a>
    </div>
</body>
</html>
