<% blogs.forEach(blog => { %>
    <div class="col-md-4">
        <div class="card">
            <% if (blog.featuredImage) { %>
                <img src="/uploads/<%= blog.featuredImage %>" class="card-img-top" alt="<%= blog.title %>">
            <% } %>
            <div class="card-body">
                <h5 class="card-title"><%= blog.title %></h5>
                <p class="card-text"><%= blog.categories.map(cat => cat.name).join(', ') %></p>
                <p class="card-text">₹<%= blog.price %></p>
                <a href="/blogs/<%= blog._id %>" class="btn btn-primary">Read More</a>
            </div>
        </div>
    </div>
<% }) %>
